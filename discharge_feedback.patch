+<?php
+
+defined('BASEPATH') or exit('No direct script access allowed');
+
+/**
+ * PUBLIC feedback form (no login needed).
+ *
+ *   Personal link (sent by email / SMS):  /discharge_feedback/patient_feedback/form/{hash}
+ *   General link (share anywhere):        /discharge_feedback/patient_feedback/form
+ */
+class Patient_feedback extends ClientsController
+{
+    public function __construct()
+    {
+        parent::__construct();
+        $this->load->model('discharge_feedback/discharge_feedback_model', 'dfb');
+    }
+
+    public function index()
+    {
+        redirect(site_url('discharge_feedback/patient_feedback/form'));
+    }
+
+    public function form($hash = '')
+    {
+        $request = null;
+
+        if ($hash !== '') {
+            $request = $this->dfb->get_by_hash($hash);
+            if (!$request) {
+                show_404();
+            }
+            if ($request['status'] === 'completed') {
+                $this->thanks(true);
+
+                return;
+            }
+        } elseif (!(int) $this->dfb->setting('allow_general_link')) {
+            show_404();
+        }
+
+        $values = [
+            'patient_name'        => $request ? (string) $request['patient_name'] : '',
+            'passport_number'     => '',
+            'incision_healed'     => 0,
+            'cardio_stable'       => 0,
+            'physician_signature' => '',
+            'license_number'      => '',
+        ];
+        $errors = [];
+
+        if ($this->input->method() === 'post') {
+            $values = [
+                'patient_name'        => $this->clean('patient_name', 191),
+                'passport_number'     => $this->clean('passport_number', 100),
+                'incision_healed'     => $this->input->post('incision_healed') ? 1 : 0,
+                'cardio_stable'       => $this->input->post('cardio_stable') ? 1 : 0,
+                'physician_signature' => $this->clean('physician_signature', 191),
+                'license_number'      => $this->clean('license_number', 100),
+            ];
+
+            if ($values['patient_name'] === '') {
+                $errors['patient_name'] = 'Please enter the patient full name.';
+            }
+            if ($values['passport_number'] === '') {
+                $errors['passport_number'] = 'Please enter the passport number.';
+            }
+
+            if (!$errors) {
+                $this->dfb->save_response(
+                    $request,
+                    $values,
+                    $this->input->ip_address(),
+                    $this->input->user_agent()
+                );
+                $this->thanks(false);
+
+                return;
+            }
+        }
+
+        $this->load->view('discharge_feedback/public/form', [
+            'values'     => $values,
+            'errors'     => $errors,
+            'action'     => $this->dfb->feedback_link($hash),
+            'csrf_name'  => $this->security->get_csrf_token_name(),
+            'csrf_hash'  => $this->security->get_csrf_hash(),
+            'company'    => get_option('companyname'),
+        ]);
+    }
+
+    private function thanks($alreadySubmitted)
+    {
+        $this->load->view('discharge_feedback/public/thanks', [
+            'already' => $alreadySubmitted,
+            'company' => get_option('companyname'),
+        ]);
+    }
+
+    private function clean($field, $maxLength)
+    {
+        $value = trim((string) $this->input->post($field));
+
+        return mb_substr($value, 0, $maxLength);
+    }
+}
