+-- ONLY needed if the module "Activate" button could not create the tables.
+-- Run in the MAIN database (phpMyAdmin > main DB > SQL). Change `tbl` if your db_prefix is different.
+
+CREATE TABLE IF NOT EXISTS `tbldischarge_feedback_requests` (
+  `id` INT(11) NOT NULL AUTO_INCREMENT,
+  `branch_id` INT(11) NOT NULL DEFAULT 0,
+  `branch_name` VARCHAR(191) NULL,
+  `lead_id` INT(11) NOT NULL,
+  `hash` VARCHAR(64) NOT NULL,
+  `patient_name` VARCHAR(191) NULL,
+  `email` VARCHAR(191) NULL,
+  `phone` VARCHAR(50) NULL,
+  `discharged_at` DATETIME NULL,
+  `status` VARCHAR(20) NOT NULL DEFAULT 'pending',
+  `send_count` INT(11) NOT NULL DEFAULT 0,
+  `last_sent_at` DATETIME NULL,
+  `last_attempt_at` DATETIME NULL,
+  `last_channels` VARCHAR(50) NULL,
+  `last_error` TEXT NULL,
+  `completed_at` DATETIME NULL,
+  `created_at` DATETIME NOT NULL,
+  PRIMARY KEY (`id`),
+  UNIQUE KEY `hash` (`hash`),
+  UNIQUE KEY `branch_lead` (`branch_id`, `lead_id`),
+  KEY `status` (`status`)
+) ENGINE=InnoDB DEFAULT CHARSET=utf8;
+
+CREATE TABLE IF NOT EXISTS `tbldischarge_feedback_responses` (
+  `id` INT(11) NOT NULL AUTO_INCREMENT,
+  `request_id` INT(11) NULL,
+  `branch_id` INT(11) NOT NULL DEFAULT 0,
+  `lead_id` INT(11) NULL,
+  `patient_name` VARCHAR(191) NOT NULL,
+  `passport_number` VARCHAR(100) NULL,
+  `incision_healed` TINYINT(1) NOT NULL DEFAULT 0,
+  `cardio_stable` TINYINT(1) NOT NULL DEFAULT 0,
+  `physician_signature` VARCHAR(191) NULL,
+  `license_number` VARCHAR(100) NULL,
+  `ip_address` VARCHAR(45) NULL,
+  `user_agent` VARCHAR(255) NULL,
+  `submitted_at` DATETIME NOT NULL,
+  PRIMARY KEY (`id`),
+  KEY `request_id` (`request_id`)
+) ENGINE=InnoDB DEFAULT CHARSET=utf8;
+
+CREATE TABLE IF NOT EXISTS `tbldischarge_feedback_log` (
+  `id` INT(11) NOT NULL AUTO_INCREMENT,
+  `request_id` INT(11) NOT NULL,
+  `channel` VARCHAR(10) NOT NULL,
+  `recipient` VARCHAR(191) NULL,
+  `is_reminder` TINYINT(1) NOT NULL DEFAULT 0,
+  `success` TINYINT(1) NOT NULL DEFAULT 0,
+  `error` TEXT NULL,
+  `sent_at` DATETIME NOT NULL,
+  PRIMARY KEY (`id`),
+  KEY `request_id` (`request_id`)
+) ENGINE=InnoDB DEFAULT CHARSET=utf8;
+
+CREATE TABLE IF NOT EXISTS `tbldischarge_feedback_settings` (
+  `name` VARCHAR(100) NOT NULL,
+  `value` TEXT NULL,
+  PRIMARY KEY (`name`)
+) ENGINE=InnoDB DEFAULT CHARSET=utf8;
+
+INSERT IGNORE INTO `tbldischarge_feedback_settings` (`name`, `value`) VALUES
+  ('start_date', NOW()),
+  ('cron_key', MD5(RAND()));
diff --git a/app/modules/discharge_feedback/uninstall.php b/app/modules/discharge_feedback/uninstall.php
new file mode 100644
index 0000000..0199452
--- /dev/null
+++ b/app/modules/discharge_feedback/uninstall.php
@@ -0,0 +1,17 @@
+<?php
+
+defined('BASEPATH') or exit('No direct script access allowed');
+
+/*
+ * Runs only when the module is UNINSTALLED (not on deactivate).
+ * Removes all discharge feedback data.
+ */
+
+$CI     = &get_instance();
+$prefix = db_prefix();
+
+foreach (['requests', 'responses', 'log', 'settings'] as $dfbTable) {
+    if ($CI->db->table_exists($prefix . 'discharge_feedback_' . $dfbTable)) {
+        $CI->db->query('DROP TABLE `' . $prefix . 'discharge_feedback_' . $dfbTable . '`');
+    }
+}
